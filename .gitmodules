[submodule "third_party/libffi"]
	path = third_party/libffi
	url = https://github.com/libffi/libffi.git
[submodule "third_party/wayland"]
	path = third_party/wayland
	url = https://github.com/SuperTurtleDev/libwayland.git
	branch = awl
[submodule "third_party/pulseaudio"]
	path = third_party/pulseaudio
	url = https://github.com/pulseaudio/pulseaudio.git
[submodule "third_party/bubblewrap"]
	path = third_party/bubblewrap
	url = https://github.com/containers/bubblewrap.git
	shallow = true
[submodule "third_party/xserver"]
	path = third_party/xserver
	url = https://gitlab.freedesktop.org/xorg/xserver.git
	branch = xwayland-24.1
	shallow = true
