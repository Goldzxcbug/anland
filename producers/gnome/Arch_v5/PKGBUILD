pkgbase=mutter
pkgname=(
  mutter
  mutter-devkit
  mutter-docs
)
pkgver=0
pkgrel=1.1

pkgdesc="Window manager and compositor for GNOME"
url="https://gitlab.gnome.org/GNOME/mutter"
arch=(aarch64)
license=(GPL-2.0-or-later)
depends=(
  at-spi2-core
  cairo
  colord
  dconf
  egl-wayland
  fontconfig
  fribidi
  gdk-pixbuf2
  glib2
  glibc
  glycin
  gnome-desktop-4
  gnome-settings-daemon
  graphene
  gsettings-desktop-schemas
  gtk4
  harfbuzz
  iio-sensor-proxy
  lcms2
  libcanberra
  libcolord
  libdisplay-info
  libdrm
  libei
  libgcc
  libgirepository
  libglvnd
  libgudev
  libinput
  libpipewire
  libsysprof-capture
  libwacom
  libx11
  libxau
  libxcb
  libxcomposite
  libxcursor
  libxdamage
  libxext
  libxfixes
  libxi
  libxinerama
  libxkbcommon
  libxrandr
  mesa
  pango
  pipewire
  pixman
  python
  python-argcomplete
  python-dbus
  python-gobject
  startup-notification
  systemd-libs
  wayland
  xorg-xwayland
)
makedepends=(
  bash-completion
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  meson
  python-docutils
  sysprof
  wayland-protocols
)
# Sources follow the current GNOME Mutter and gvdb default branches.
source=(
  'mutter::git+https://gitlab.gnome.org/GNOME/mutter.git'
  'gvdb::git+https://gitlab.gnome.org/GNOME/gvdb.git'
  'mutter.patch'
  'mutter-overlay.tar.gz'
)
sha512sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

_mutter_version() {
  python3 - "$srcdir/mutter/meson.build" <<'PY_VERSION'
import re,sys
text=open(sys.argv[1]).read()
match=re.search(r"project\(\s*['\"]mutter['\"][\s\S]*?version:\s*['\"]([0-9]+(?:\.[0-9]+)+)",text)
if not match: raise SystemExit('cannot read Mutter project version')
print(match.group(1))
PY_VERSION
}

pkgver() {
  cd "$srcdir/mutter"
  printf '%s.r%s.g%s\n' "$(_mutter_version)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  [[ "$(uname -m)" == aarch64 ]] || { error 'Arch Mutter port requires aarch64'; return 1; }
  local tree="$srcdir/mutter"
  local gvdb="$srcdir/gvdb"
  [[ -d "$tree/subprojects" && -f "$gvdb/meson.build" ]] || return 1
  rm -rf "$tree/subprojects/gvdb"
  cp -a "$gvdb" "$tree/subprojects/gvdb" || return 1
  tar -xzf "$srcdir/mutter-overlay.tar.gz" -C "$tree" || return 1
  patch --batch --forward --fuzz=2 --no-backup-if-mismatch -p1 -d "$tree" -i "$srcdir/mutter.patch" || return 1
}

build() {
  local mutter_version
  mutter_version=$(_mutter_version) || return 1
  local meson_options=(
    -D docs=true
    -D egl_device=true
    -D installed_tests=false
    -D tests=disabled
    -D wayland_eglstream=true
    -D anland=enabled
    "-Dc_args=-DANLAND_MUTTER_${mutter_version%%.*}"
  )

  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=" -Wl,-Bsymbolic-functions"

  # Inject gvdb
  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  arch-meson "$srcdir/mutter" build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_mutter() {
  meson install -C build --destdir "$pkgdir" || return 1
  local library soname
  library=$(find "$pkgdir/usr/lib" -maxdepth 1 -type f -name 'libmutter-*.so.*' -print -quit)
  [[ -n "$library" ]] || { error 'Mutter shared library missing'; return 1; }
  soname=${library##*/}
  soname=${soname%%.so.*}
  provides=("$soname.so")
  optdepends=(
    'bash-completion: Bash completions for gdctl'
    'mutter-devkit: Mutter SDK, "MDK"'
  )

  _pick devkit "$pkgdir"/usr/lib/mutter-devkit
  _pick devkit "$pkgdir"/usr/share/applications/org.gnome.Mutter.Mdk.desktop
  _pick devkit "$pkgdir"/usr/share/icons/hicolor/scalable/apps/org.gnome.Mutter.Mdk.Devel.svg
  _pick devkit "$pkgdir"/usr/share/icons/hicolor/scalable/apps/org.gnome.Mutter.Mdk.svg
  _pick devkit "$pkgdir"/usr/share/icons/hicolor/symbolic/apps/org.gnome.Mutter.Mdk-symbolic.svg

  _pick docs "$pkgdir"/usr/share/mutter-*/doc
}

package_mutter-devkit() {
  pkgdesc="GNOME Mutter Development Kit"
  depends=(
    cairo
    glib2
    glibc
    gtk4
    hicolor-icon-theme
    libadwaita
    libei
    libgcc
    libpipewire
    libxkbcommon
    mutter
  )

  mv devkit/* "$pkgdir"
}

package_mutter-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv docs/* "$pkgdir"
}

