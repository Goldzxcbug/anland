+/* anland: parent lookup by mount id through a sorted pointer array instead
+ * of upstream's table indexed by the raw id (xcalloc (max_id + 1, ...)).
+ * Kernels with SuSFS (KernelSU) give every mount created or cloned by a
+ * KernelSU-domain process a fake id counted from DEFAULT_KSU_MNT_ID =
+ * 2000000000 (susfs_def.h); a droidspaces container is entirely such
+ * mounts, so that table is 16 GB of address space. glycin runs its image
+ * loaders through bwrap under RLIMIT_AS (80% of MemAvailable+SwapFree,
+ * capped at 20 GB → never enough) — bwrap died with "Out of memory" before
+ * mounting anything, no SVG could be loaded and GTK aborted on the
+ * image-missing fallback (gtkiconhelper.c ensure_surface_for_gicon). */
+static int
+compare_mountinfo_line_by_id (const void *a, const void *b)
+{
+  const MountInfoLine *la = *(MountInfoLine * const *) a;
+  const MountInfoLine *lb = *(MountInfoLine * const *) b;
+
+  if (la->id < lb->id)
+    return -1;
+  if (la->id > lb->id)
+    return 1;
+  return 0;
+}
+
+static MountInfoLine *
+lookup_mountinfo_line_by_id (MountInfoLine **by_id,
+                             unsigned int    n_lines,
+                             int             id)
+{
+  MountInfoLine key;
+  MountInfoLine *keyp = &key;
+  MountInfoLine **found;
+
+  key.id = id;
+  found = bsearch (&keyp, by_id, n_lines, sizeof (MountInfoLine *),
+                   compare_mountinfo_line_by_id);
+  return found != NULL ? *found : NULL;
+}
